FROM node:20-alpine

WORKDIR /app

# Copia apenas os arquivos de dependências primeiro (otimiza o cache do Docker)
COPY package.json package-lock.json* ./

# Instala todas as dependências
RUN npm install

# Copia o restante dos arquivos do projeto
COPY . .

# Expõe a porta configurada no vite.config.ts
EXPOSE 4000

# Variável de ambiente configurada para desenvolvimento
ENV NODE_ENV=development
ENV PORT=4000

# Comando para iniciar a SPA Vite em modo dev
CMD ["npm", "run", "dev"]
